{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trivianinstitute.org/tria/schemas/governance_decision.schema.json",
  "title": "TRIA Governance Decision",
  "type": "object",
  "required": ["outcome", "policy_id", "policy_version", "reason"],
  "properties": {
    "outcome": {"type": "string", "enum": ["ALLOW", "BLOCK", "REQUIRE_CONSENT", "ESCALATE", "DEFER", "PAUSE"]},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "evaluated_at": {"type": ["string", "null"], "format": "date-time"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
