{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trivianfield.com/schemas/tria-agent-comparison-experiment.v0.1.schema.json",
  "title": "TRIA Agent Comparison Experiment v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "evaluator_policy", "protocol", "scenarios"],
  "properties": {
    "schema": {"const": "tria.agent-comparison-experiment/0.1"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["tria_sdk", "diagnostic_spec"],
      "properties": {
        "tria_sdk": {"type": "string", "minLength": 1},
        "diagnostic_spec": {"const": "0.1"}
      }
    },
    "evaluator_policy": {"const": "tria.agent-decision-rubric/0.1"},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["conditions", "decision_options", "max_output_tokens", "max_tool_calls"],
      "properties": {
        "conditions": {
          "const": ["ordinary_records", "structured_evidence", "structured_plus_tria"]
        },
        "decision_options": {"const": ["EXECUTE", "DEFER", "REQUEST_EVIDENCE"]},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "max_tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "scenarios": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "nullableBoolean": {"type": ["boolean", "null"]},
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "family", "task", "evidence", "evaluator"],
      "properties": {
        "id": {"type": "string", "pattern": "^ace-[0-9]{3}-"},
        "family": {"type": "string", "minLength": 1},
        "task": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": [
            "host_authentication", "external_authority_current", "reversibility",
            "permission_state", "permission_purpose", "required_purpose",
            "consent_required", "consent_state", "lifecycle", "claim_status"
          ],
          "properties": {
            "host_authentication": {"$ref": "#/$defs/nullableBoolean"},
            "external_authority_current": {"$ref": "#/$defs/nullableBoolean"},
            "reversibility": {"$ref": "#/$defs/nullableBoolean"},
            "permission_state": {"enum": ["active", "revoked", "missing"]},
            "permission_purpose": {"type": ["string", "null"]},
            "required_purpose": {"type": ["string", "null"]},
            "consent_required": {"type": "boolean"},
            "consent_state": {"enum": ["active", "revoked", "missing", "not_required"]},
            "lifecycle": {"enum": ["FORMING", "ACTIVE", "RESTING"]},
            "claim_status": {"enum": ["none", "active", "contested"]}
          }
        },
        "evaluator": {
          "type": "object", "additionalProperties": false,
          "required": ["correct_decision", "reason"],
          "properties": {
            "correct_decision": {"enum": ["EXECUTE", "DEFER", "REQUEST_EVIDENCE"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
